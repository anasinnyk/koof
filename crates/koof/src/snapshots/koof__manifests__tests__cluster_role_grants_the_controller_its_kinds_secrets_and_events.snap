---
source: crates/koof/src/manifests.rs
expression: cluster_role(&crds())
---
{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRole",
  "metadata": {
    "name": "provider"
  },
  "rules": [
    {
      "apiGroups": [
        "example.dev"
      ],
      "resources": [
        "accounts",
        "zones",
        "records"
      ],
      "verbs": [
        "get",
        "list",
        "watch",
        "patch",
        "update"
      ]
    },
    {
      "apiGroups": [
        "example.dev"
      ],
      "resources": [
        "accounts/status",
        "zones/status",
        "records/status"
      ],
      "verbs": [
        "get",
        "patch",
        "update"
      ]
    },
    {
      "apiGroups": [
        "example.dev"
      ],
      "resources": [
        "accounts/finalizers",
        "zones/finalizers",
        "records/finalizers"
      ],
      "verbs": [
        "update"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "secrets"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "events.k8s.io"
      ],
      "resources": [
        "events"
      ],
      "verbs": [
        "create",
        "patch"
      ]
    }
  ]
}
