---
source: crates/koof/src/manifests.rs
expression: "kustomization(&PROVIDER, \"ghcr.io/example/koof-example\")"
---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: koof-example
namePrefix: koof-example-
labels:
  - pairs:
      app.kubernetes.io/instance: koof-example
    includeSelectors: true
resources:
  - ../../base
  - crds.yaml
  - rbac.yaml
images:
  - name: provider
    newName: ghcr.io/example/koof-example
    newTag: "[version]"
